# Reference only: this scaffold does NOT load .env files.
# No API key is read or required; runtime integrations are NOT IMPLEMENTED.
GEMINI_API_KEY=YOUR_LOCAL_API_KEY_HERE
GEMINI_MODEL=YOUR_CHOSEN_GEMINI_MODEL
GEMINI_ENDPOINT=https://unconfigured.invalid/gemini
# Default profile registry root: ${user.home}/.photopilot/data (independent of working directory).
# Business files live under profiles/<uuid>/; normal startup opens the persisted default profile.
# Existing unscoped inventory/session files are copied once with originals preserved.
# Close older app versions before migration; back up the complete root including profiles.json.
# Optional: set an actual environment variable to an absolute existing or new data directory.
# PHOTOPILOT_DATA_DIR=/absolute/path/to/photopilot-data
PHOTOPILOT_RANKING=portability
# Optional actual environment variable (this file is not automatically loaded):
# PHOTOPILOT_CONFIG_DIR=/absolute/path/to/photopilot-config
# Default language preference path: ${user.home}/.photopilot/preferences.json
# Existing settings.properties is read if JSON is absent; first explicit save copies values without deleting it.
